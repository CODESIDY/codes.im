---
import Layout from '../layouts/Layout.astro';
---

<Layout lang="en" title="404 – Not found" description="Page not found.">
  <div class="py-24 text-center">
    <p class="font-mono text-sm text-brand-600 dark:text-brand-400">$ cd ./this-page</p>
    <h1 class="mt-3 text-3xl font-bold text-zinc-900 dark:text-zinc-50">404 · No such file or directory</h1>
    <p class="mt-3 text-zinc-500">页面不存在 / This page doesn’t exist.</p>
    <div class="mt-6 flex justify-center gap-2">
      <a class="btn btn-primary" href="/en/">All tools</a>
      <a class="btn" href="/zh/">全部工具</a>
    </div>
  </div>
</Layout>
