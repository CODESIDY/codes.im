---
import { Code } from 'astro:components';
import Layout from '../../../layouts/Layout.astro';
import { langs, useTranslations, type Lang } from '../../../i18n/ui';
import { getStatus, httpStatuses, statusClass, type HttpStatus } from '../../../data/http-status';
import { inlineCode, plain } from '../../../lib/inline';

export function getStaticPaths() {
  return langs.flatMap((lang) => httpStatuses.map((s) => ({ params: { lang, code: String(s.code) }, props: { s } })));
}

const { s } = Astro.props as { s: HttpStatus };
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
const t = useTranslations(lang);
const tx = s.text[lang];
const cls = Math.floor(s.code / 100);
const error = cls >= 4;
const title = zh ? `HTTP ${s.code} ${s.name} 是什么意思？${error ? '原因与解决方法' : '用法说明'}` : `HTTP ${s.code} ${s.name}: Meaning${error ? ', Causes and Fixes' : ' and Usage'}`;
const description = plain(tx.summary) + ' ' + plain(tx.details);
const related = s.related.map(getStatus).filter((x): x is HttpStatus => !!x);
const idx = httpStatuses.findIndex((x) => x.code === s.code);
const prev = httpStatuses[idx - 1];
const next = httpStatuses[idx + 1];

// A representative raw response.
const extra: Record<number, string> = {
  101: 'Upgrade: websocket\nConnection: Upgrade',
  103: 'Link: </style.css>; rel=preload; as=style',
  201: 'Location: /api/users/42\nContent-Type: application/json',
  202: 'Location: /api/jobs/7f3a\nContent-Type: application/json',
  206: 'Content-Range: bytes 0-1023/146515\nContent-Length: 1024',
  301: 'Location: https://example.com/new-path',
  302: 'Location: /login?next=%2Fdashboard',
  303: 'Location: /orders/1001',
  304: 'ETag: "33a64df5"\nCache-Control: max-age=0, must-revalidate',
  307: 'Location: https://api.example.com/v2/upload',
  308: 'Location: https://api.example.com/v2/users',
  401: 'WWW-Authenticate: Bearer realm="api", error="invalid_token"',
  405: 'Allow: GET, HEAD',
  429: 'Retry-After: 30\nX-RateLimit-Remaining: 0',
  503: 'Retry-After: 120',
};
const raw = `HTTP/1.1 ${s.code} ${s.name}\n${extra[s.code] ? extra[s.code] + '\n' : ''}Date: Thu, 22 Oct 2026 08:00:00 GMT`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'codes.im', item: `https://codes.im/${lang}/` },
      { '@type': 'ListItem', position: 2, name: zh ? 'HTTP 状态码' : 'HTTP status codes', item: `https://codes.im/${lang}/http-status/` },
      { '@type': 'ListItem', position: 3, name: `${s.code} ${s.name}`, item: `https://codes.im/${lang}/http-status/${s.code}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: zh ? `HTTP ${s.code} 是什么意思？` : `What does HTTP ${s.code} mean?`,
        acceptedAnswer: { '@type': 'Answer', text: description },
      },
      ...(error
        ? [
            {
              '@type': 'Question',
              name: zh ? `怎么解决 HTTP ${s.code} 错误？` : `How do I fix an HTTP ${s.code} error?`,
              acceptedAnswer: { '@type': 'Answer', text: tx.items.map(plain).join(' ') },
            },
          ]
        : []),
    ],
  },
];
const colour = cls === 2 ? 'text-emerald-600 dark:text-emerald-400' : cls === 3 ? 'text-sky-600 dark:text-sky-400' : cls === 4 ? 'text-amber-600 dark:text-amber-400' : cls === 5 ? 'text-red-600 dark:text-red-400' : 'text-zinc-500';
---

<Layout lang={lang} title={title} description={description} jsonLd={jsonLd}>
  <nav class="mb-4 text-xs text-zinc-500" aria-label="breadcrumb">
    <a href={`/${lang}/`} class="hover:text-zinc-900 dark:hover:text-zinc-200">{t('nav.tools')}</a>
    <span class="mx-1.5">/</span>
    <a href={`/${lang}/http-status/`} class="hover:text-zinc-900 dark:hover:text-zinc-200">{zh ? 'HTTP 状态码' : 'HTTP status codes'}</a>
  </nav>

  <article class="prose-tool max-w-3xl">
    <p class="font-mono text-sm text-zinc-500">{statusClass[cls][lang].name}{s.unofficial && ` · ${zh ? '非标准，' : 'Non-standard, '}${s.unofficial}`}</p>
    <h1 class="mt-1 flex flex-wrap items-baseline gap-x-3 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">
      <span class:list={['font-mono', colour]}>{s.code}</span>
      <span>{s.name}</span>
    </h1>
    <p class="mt-4 text-base! leading-7 text-zinc-800! dark:text-zinc-200!" set:html={inlineCode(tx.summary)} />
    <p class="mt-3" set:html={inlineCode(tx.details)} />

    <h2>{error ? (zh ? '常见原因与解决方法' : 'Common causes and fixes') : zh ? '使用说明' : 'Notes'}</h2>
    <ul class="list-disc space-y-1.5 pl-5">
      {tx.items.map((i) => <li set:html={inlineCode(i)} />)}
    </ul>

    <h2>{zh ? '响应示例' : 'Example response'}</h2>
    <Code code={raw} lang="http" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
    <p class="mt-2 text-xs">
      {zh ? '用 ' : 'Check a URL’s status with '}<code>curl -I https://example.com</code>{zh ? ' 可以查看某个地址返回的状态码和响应头。' : ', which prints the status line and headers.'}
    </p>

    {
      related.length > 0 && (
        <>
          <h2>{zh ? '相关状态码' : 'Related status codes'}</h2>
          <ul class="grid gap-2 sm:grid-cols-2">
            {related.map((r) => (
              <li>
                <a href={`/${lang}/http-status/${r.code}/`} class="card flex gap-3 p-3 hover:border-brand-400">
                  <span class="font-mono font-semibold text-zinc-900 dark:text-zinc-100">{r.code}</span>
                  <span class="text-sm text-zinc-600 dark:text-zinc-400">{r.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h2>{zh ? '相关工具' : 'Related tools'}</h2>
    <p>
      <a href={`/${lang}/curl-converter/`} class="text-brand-700 hover:underline dark:text-brand-400">{zh ? 'curl 转代码' : 'curl to Code'}</a> ·
      <a href={`/${lang}/llm-api-playground/`} class="text-brand-700 hover:underline dark:text-brand-400">{zh ? 'LLM API 调试台' : 'LLM API Playground'}</a> ·
      <a href={`/${lang}/llm-stream-parser/`} class="text-brand-700 hover:underline dark:text-brand-400">{zh ? '大模型流式响应解析' : 'LLM Stream Parser'}</a>
    </p>

    <nav class="mt-10 flex justify-between gap-4 border-t border-zinc-200 pt-4 text-sm dark:border-zinc-800">
      {prev ? <a href={`/${lang}/http-status/${prev.code}/`} class="text-zinc-600 hover:text-brand-700 dark:text-zinc-400">← {prev.code} {prev.name}</a> : <span />}
      <a href={`/${lang}/http-status/`} class="text-zinc-500 hover:text-brand-700">{zh ? '全部状态码' : 'All codes'}</a>
      {next ? <a href={`/${lang}/http-status/${next.code}/`} class="text-right text-zinc-600 hover:text-brand-700 dark:text-zinc-400">{next.code} {next.name} →</a> : <span />}
    </nav>
  </article>
</Layout>
