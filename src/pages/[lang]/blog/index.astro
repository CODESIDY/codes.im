---
import Layout from '../../../layouts/Layout.astro';
import BlogListing from '../../../components/blog/BlogListing.astro';
import { langs, useTranslations, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../lib/posts';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `codes.im ${t('blog.title')}`,
    url: `https://codes.im/${lang}/blog/`,
    inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  },
];
---

<Layout lang={lang} title={t('blog.title')} description={t('blog.description')} jsonLd={jsonLd}>
  <BlogListing lang={lang} posts={posts} allPosts={posts}>
    <div slot="header">
      <p class="font-mono text-sm text-brand-600 dark:text-brand-400">$ ls ./blog</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">{t('blog.title')}</h1>
      <p class="mt-2 max-w-2xl text-zinc-600 dark:text-zinc-400">{t('blog.description')}</p>
    </div>
  </BlogListing>
</Layout>
