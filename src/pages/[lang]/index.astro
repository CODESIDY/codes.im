---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { langs, useTranslations, type Lang } from '../../i18n/ui';
import { categories, tools } from '../../tools/registry';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const latest = (await getPosts(lang)).slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'codes.im',
    url: `https://codes.im/${lang}/`,
    description: t('site.description'),
    inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  },
];
---

<Layout lang={lang} title="codes.im" description={t('site.description')} jsonLd={jsonLd}>
  <section class="relative py-10 sm:py-16">
    <div
      class="pointer-events-none absolute inset-x-0 -top-8 -z-10 h-64 bg-[radial-gradient(ellipse_at_top,var(--color-brand-100),transparent_65%)] opacity-70 dark:opacity-20"
    >
    </div>
    <p class="font-mono text-sm text-brand-600 dark:text-brand-400">$ codes.im --help</p>
    <h1 class="mt-3 max-w-3xl text-3xl font-bold tracking-tight text-balance text-zinc-900 sm:text-5xl dark:text-zinc-50">
      {t('home.hero.title')}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-7 text-pretty text-zinc-600 sm:text-lg dark:text-zinc-400">
      {t('home.hero.subtitle')}
    </p>
    <ul class="mt-6 flex flex-wrap gap-2 text-xs">
      {
        (['home.badge.private', 'home.badge.free', 'home.badge.oss'] as const).map((k) => (
          <li class="rounded-full border border-zinc-200 bg-white px-3 py-1 text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
            <span class="mr-1 text-brand-600 dark:text-brand-400">✓</span>
            {t(k)}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="mine" class="mt-4" hidden>
    <div class="mb-3 flex items-baseline justify-between">
      <h2 class="text-sm font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">{t('home.mine')}</h2>
      <button type="button" id="mine-clear" class="cursor-pointer text-xs text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200">{t('home.clearRecent')}</button>
    </div>
    <div class="space-y-2">
      <div id="mine-fav" class="flex flex-wrap items-center gap-2" data-label={`★ ${t('home.favorites')}`}></div>
      <div id="mine-recent" class="flex flex-wrap items-center gap-2" data-label={t('home.recent')}></div>
    </div>
  </section>

  {
    categories.map((c) => {
      const list = tools.filter((tool) => tool.category === c);
      return list.length ? (
        <section class="mt-10">
          <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">
            <a href={`/${lang}/tools/${c}/`} class="hover:text-brand-700 dark:hover:text-brand-400">{t(`cat.${c}`)}</a>
            {(c === 'ai' || c === 'llm') && (
              <span class="rounded-full bg-brand-600 px-2 py-0.5 text-[10px] font-semibold tracking-normal text-white normal-case dark:bg-brand-500 dark:text-zinc-950">
                {t('home.new')}
              </span>
            )}
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {list.map((tool) => (
              <ToolCard tool={tool} lang={lang} />
            ))}
          </div>
        </section>
      ) : null;
    })
  }

  <section class="mt-12">
    <h2 class="mb-4 text-sm font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">{t('home.reference')}</h2>
    <a href={`/${lang}/http-status/`} class="group card flex items-center gap-4 p-4 transition hover:border-brand-400 dark:hover:border-brand-500/60">
      <span class="flex shrink-0 gap-1 font-mono text-sm font-semibold">
        <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400">200</span>
        <span class="rounded bg-amber-50 px-1.5 py-0.5 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400">404</span>
        <span class="rounded bg-red-50 px-1.5 py-0.5 text-red-700 dark:bg-red-500/10 dark:text-red-400">502</span>
      </span>
      <span class="min-w-0">
        <span class="block font-medium text-zinc-900 group-hover:text-brand-700 dark:text-zinc-100 dark:group-hover:text-brand-400">{t('nav.reference')}</span>
        <span class="block text-sm text-zinc-500 dark:text-zinc-400">{t('home.referenceDesc')}</span>
      </span>
    </a>
  </section>

  {
    latest.length > 0 && (
      <section class="mt-16">
        <div class="mb-2 flex items-baseline justify-between">
          <h2 class="text-sm font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">{t('blog.latest')}</h2>
          <a href={`/${lang}/blog/`} class="text-sm text-brand-700 hover:underline dark:text-brand-400">{t('blog.back')} →</a>
        </div>
        <div class="mt-2 grid gap-5 md:grid-cols-3">
          {latest.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </div>
      </section>
    )
  }
</Layout>

<script>
  import { clearRecent, getFavorites, getRecent } from '../../scripts/prefs';

  interface Entry {
    name: string;
    href: string;
    glyph: string;
    slug: string;
    type: string;
  }
  const tools: Entry[] = JSON.parse(document.getElementById('tool-index')?.textContent || '[]').filter((e: Entry) => e.type === 'tool');
  const bySlug = new Map(tools.map((e) => [e.slug, e]));

  function row(el: HTMLElement, slugs: string[]) {
    const items = slugs.map((s) => bySlug.get(s)).filter((e): e is Entry => !!e);
    el.replaceChildren();
    el.hidden = !items.length;
    if (!items.length) return 0;
    const label = document.createElement('span');
    label.className = 'w-20 shrink-0 text-xs text-zinc-500';
    label.textContent = el.dataset.label!;
    el.append(label);
    for (const e of items) {
      const a = document.createElement('a');
      a.href = e.href;
      a.className =
        'inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-sm text-zinc-800 transition hover:border-brand-400 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:border-brand-500/60';
      const g = document.createElement('span');
      g.className = 'font-mono text-[11px] font-semibold text-brand-700 dark:text-brand-400';
      g.textContent = e.glyph;
      a.append(g, e.name);
      el.append(a);
    }
    return items.length;
  }

  function render() {
    const favs = getFavorites();
    const n = row(document.getElementById('mine-fav')!, favs) + row(document.getElementById('mine-recent')!, getRecent().filter((s) => !favs.includes(s)));
    document.getElementById('mine')!.hidden = n === 0;
    document.getElementById('mine-clear')!.hidden = getRecent().length === 0;
  }
  document.getElementById('mine-clear')!.addEventListener('click', () => {
    clearRecent();
    render();
  });
  render();
</script>
