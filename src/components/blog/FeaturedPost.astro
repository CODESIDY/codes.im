---
import Cover from './Cover.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { formatDate, postUrl, readingMinutes, type Post } from '../../lib/posts';

interface Props {
  post: Post;
  lang: Lang;
}
const { post, lang } = Astro.props;
const t = useTranslations(lang);
const d = post.data;
---

<article class="group relative grid overflow-hidden rounded-2xl border border-zinc-200 bg-white transition hover:border-brand-400 hover:shadow-xl hover:shadow-brand-500/5 md:grid-cols-[1.2fr_1fr] dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-brand-500/60">
  <Cover post={post} lang={lang} class="aspect-[1.91/1] md:m-3 md:self-center md:rounded-xl" width={560} eager />
  <div class="flex flex-col justify-center p-6 sm:p-8">
    <p class="mb-3 flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full bg-zinc-900 px-2.5 py-0.5 font-medium text-white dark:bg-zinc-100 dark:text-zinc-900">★ {t('blog.featured')}</span>
      {d.kind === 'tutorial' && <span class="rounded-full bg-brand-50 px-2 py-0.5 font-medium text-brand-700 dark:bg-brand-500/10 dark:text-brand-400">{t('blog.tutorial')}</span>}
    </p>
    <h2 class="text-xl leading-snug font-bold tracking-tight text-balance text-zinc-900 group-hover:text-brand-700 sm:text-2xl dark:text-zinc-50 dark:group-hover:text-brand-400">
      <a href={postUrl(post)} class="after:absolute after:inset-0">{d.title}</a>
    </h2>
    <p class="mt-3 line-clamp-3 text-sm leading-7 text-zinc-600 dark:text-zinc-400">{d.description}</p>
    <p class="mt-4 text-xs text-zinc-500">
      <time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time> · {readingMinutes(post.body)} {t('blog.min')}
    </p>
  </div>
</article>
