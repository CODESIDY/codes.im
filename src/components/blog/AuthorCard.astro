---
import { config } from '../../config';
import { projects } from '../../data/projects';
import { useTranslations, type Lang } from '../../i18n/ui';
import { tools } from '../../tools/registry';

interface Props {
  lang: Lang;
  postCount: number;
}
const { lang, postCount } = Astro.props;
const t = useTranslations(lang);
const initials = config.author
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

const stats = [
  { n: postCount, label: t('blog.statPosts'), href: `/${lang}/blog/` },
  { n: tools.length, label: t('blog.statTools'), href: `/${lang}/` },
  { n: projects.length, label: t('blog.statProjects'), href: `/${lang}/projects/` },
];

const icons: Record<string, string> = {
  github:
    'M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z',
  x: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12Z',
  mail: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.6-8-5.6ZM5.4 7l6.6 4.6L18.6 7H5.4Z',
  rss: 'M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zm0 5.66A9.9 9.9 0 0 1 13.9 20h-2.83A7.07 7.07 0 0 0 4 12.93z',
};

const links = [
  { name: 'GitHub', href: config.github, icon: icons.github },
  { name: 'X', href: config.social.x, icon: icons.x },
  { name: lang === 'zh' ? '掘金' : 'Juejin', href: config.social.juejin, text: lang === 'zh' ? '掘' : 'J' },
  { name: lang === 'zh' ? '知乎' : 'Zhihu', href: config.social.zhihu, text: lang === 'zh' ? '知' : 'Z' },
  { name: 'Bilibili', href: config.social.bilibili, text: 'B' },
  { name: 'Email', href: config.email ? `mailto:${config.email}` : '', icon: icons.mail },
  { name: 'RSS', href: `/${lang}/rss.xml`, icon: icons.rss },
].filter((l) => l.href);
---

<section class="card overflow-hidden">
  <div class="h-16 bg-[radial-gradient(120%_140%_at_0%_0%,var(--color-brand-400),transparent_60%),radial-gradient(120%_140%_at_100%_0%,var(--color-sky-400),transparent_60%)] opacity-60 dark:opacity-40"></div>
  <div class="-mt-9 px-5 pb-5 text-center">
    {
      config.avatar ? (
        <img src={config.avatar} alt={config.author} width="72" height="72" class="mx-auto h-18 w-18 rounded-full border-4 border-white object-cover dark:border-zinc-900" />
      ) : (
        <span class="mx-auto grid h-18 w-18 place-items-center rounded-full border-4 border-white bg-zinc-900 font-mono text-xl font-semibold text-brand-400 dark:border-zinc-900 dark:bg-zinc-100 dark:text-brand-700">
          {initials}
        </span>
      )
    }
    <h2 class="mt-2 font-semibold text-zinc-900 dark:text-zinc-100">{config.author}</h2>
    <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{config.bio[lang]}</p>

    <dl class="mt-4 grid grid-cols-3 divide-x divide-zinc-200 rounded-lg bg-zinc-50 py-2 dark:divide-zinc-800 dark:bg-zinc-800/50">
      {
        stats.map((s) => (
          <a href={s.href} class="group">
            <dd class="font-mono text-lg font-semibold text-zinc-900 group-hover:text-brand-600 dark:text-zinc-100">{s.n}</dd>
            <dt class="text-[11px] text-zinc-500">{s.label}</dt>
          </a>
        ))
      }
    </dl>

    <div class="mt-4 flex flex-wrap justify-center gap-1.5">
      {
        links.map((l) => (
          <a
            href={l.href}
            target={l.href.startsWith('http') ? '_blank' : undefined}
            rel={l.href.startsWith('http') ? 'noopener me' : undefined}
            aria-label={l.name}
            title={l.name}
            class="grid h-8 w-8 place-items-center rounded-lg border border-zinc-200 text-zinc-500 transition hover:border-brand-400 hover:text-brand-600 dark:border-zinc-700 dark:text-zinc-400"
          >
            {l.icon ? (
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d={l.icon} />
              </svg>
            ) : (
              <span class="text-xs font-bold">{l.text}</span>
            )}
          </a>
        ))
      }
    </div>
    <a href={`/${lang}/about/`} class="mt-4 inline-block text-xs text-brand-700 hover:underline dark:text-brand-400">{t('blog.aboutMe')} →</a>
  </div>
</section>
