---
import { useTranslations, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = {
  en: {
    toB64: 'Image → Base64',
    toImg: 'Base64 → Image',
    drop: 'Drop an image here, paste, or click to choose',
    hint: 'PNG, JPEG, WebP, GIF, SVG, ICO · converted locally, never uploaded',
    paste: 'Paste a data: URI or raw Base64',
    file: 'File',
    dims: 'Dimensions',
    size: 'Original',
    encoded: 'Base64 length',
    download: 'Download image',
    big: 'Data URIs over ~10 KB usually hurt page performance — consider a normal image file instead.',
    kinds: { uri: 'Data URI', base64: 'Base64 only', html: 'HTML <img>', css: 'CSS background', markdown: 'Markdown', json: 'Claude API image block' },
    bad: 'Could not decode this as an image.',
  },
  zh: {
    toB64: '图片 → Base64',
    toImg: 'Base64 → 图片',
    drop: '把图片拖到这里、直接粘贴，或点击选择',
    hint: '支持 PNG、JPEG、WebP、GIF、SVG、ICO · 本地转换，不会上传',
    paste: '粘贴 data: URI 或纯 Base64 字符串',
    file: '文件',
    dims: '尺寸',
    size: '原始大小',
    encoded: 'Base64 长度',
    download: '下载图片',
    big: '超过约 10 KB 的 Data URI 通常会拖慢页面，建议改用普通图片文件。',
    kinds: { uri: 'Data URI', base64: '仅 Base64', html: 'HTML <img>', css: 'CSS 背景', markdown: 'Markdown', json: 'Claude API 图片块' },
    bad: '无法把它解码成图片。',
  },
}[lang];
---

<div id="ib" data-l={JSON.stringify(L)}>
  <div class="mb-4 flex flex-wrap gap-1.5">
    <label class="chip"><input type="radio" name="ib-mode" value="enc" checked class="sr-only" />{L.toB64}</label>
    <label class="chip"><input type="radio" name="ib-mode" value="dec" class="sr-only" />{L.toImg}</label>
  </div>

  <section id="ib-enc">
    <label
      id="ib-drop"
      class="flex cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-zinc-300 px-4 py-8 text-center transition hover:border-brand-500 data-[over]:border-brand-500 data-[over]:bg-brand-50 dark:border-zinc-700 dark:data-[over]:bg-brand-500/10"
    >
      <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{L.drop}</span>
      <span class="text-xs text-zinc-500">{L.hint}</span>
      <input id="ib-file" type="file" accept="image/*,.svg,.ico" class="sr-only" />
    </label>

    <div id="ib-result" class="mt-4 grid gap-4 md:grid-cols-[220px_1fr]" hidden>
      <div>
        <div class="grid aspect-square place-items-center overflow-hidden rounded-lg border border-zinc-200 bg-[conic-gradient(#f4f4f5_25%,#fff_0_50%,#f4f4f5_0_75%,#fff_0)] bg-[length:16px_16px] dark:border-zinc-800">
          <img id="ib-img" class="max-h-full max-w-full object-contain" alt="" />
        </div>
        <dl class="mt-2 space-y-0.5 font-mono text-xs text-zinc-500">
          <div><dt class="inline">{L.file}: </dt><dd id="ib-name" class="inline break-all"></dd></div>
          <div><dt class="inline">{L.dims}: </dt><dd id="ib-dims" class="inline"></dd></div>
          <div><dt class="inline">{L.size}: </dt><dd id="ib-size" class="inline"></dd></div>
          <div><dt class="inline">{L.encoded}: </dt><dd id="ib-len" class="inline"></dd></div>
        </dl>
      </div>
      <div class="min-w-0">
        <div class="mb-2 flex flex-wrap items-center gap-1.5">
          {
            Object.entries(L.kinds).map(([k, v], i) => (
              <label class="chip">
                <input type="radio" name="ib-kind" value={k} checked={i === 0} class="sr-only" />
                {v}
              </label>
            ))
          }
          <button type="button" class="btn ml-auto px-2 py-1 text-xs" data-copy="#ib-out">{t('common.copy')}</button>
        </div>
        <textarea id="ib-out" class="field min-h-56!" readonly spellcheck="false"></textarea>
        <p id="ib-big" class="mt-2 text-xs text-amber-700 dark:text-amber-400" hidden>{L.big}</p>
      </div>
    </div>
  </section>

  <section id="ib-dec" hidden>
    <label class="label" for="ib-in">{L.paste}</label>
    <textarea id="ib-in" class="field min-h-40!" spellcheck="false" placeholder="data:image/png;base64,iVBORw0KGgo…"></textarea>
    <p id="ib-err" class="mt-3 error-box" hidden></p>
    <div id="ib-prev" class="mt-4 flex flex-wrap items-end gap-4" hidden>
      <img id="ib-img2" class="max-h-72 max-w-full rounded-lg border border-zinc-200 dark:border-zinc-800" alt="" />
      <div class="space-y-2">
        <p id="ib-info" class="font-mono text-xs text-zinc-500"></p>
        <a id="ib-dl" class="btn btn-primary">{L.download}</a>
      </div>
    </div>
  </section>
</div>

<script>
  import { base64Size, formatBytes, parseDataUri, snippet, type SnippetKind } from '../../lib/image';

  const root = document.getElementById('ib')!;
  const L = JSON.parse(root.dataset.l!);
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  let dataUri = '';
  let fileName = 'image';

  const mode = () => (root.querySelector('input[name="ib-mode"]:checked') as HTMLInputElement).value;
  root.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name === 'ib-mode') {
      $('ib-enc').hidden = mode() !== 'enc';
      $('ib-dec').hidden = mode() !== 'dec';
    }
    if (el.name === 'ib-kind') renderOut();
  });

  function renderOut() {
    if (!dataUri) return;
    const kind = (root.querySelector('input[name="ib-kind"]:checked') as HTMLInputElement).value as SnippetKind;
    $<HTMLTextAreaElement>('ib-out').value = snippet(kind, dataUri, fileName.replace(/\.[^.]+$/, ''));
  }

  function load(file: File) {
    if (!file.type.startsWith('image/') && !/\.(svg|ico)$/i.test(file.name)) return;
    fileName = file.name;
    const reader = new FileReader();
    reader.onload = () => {
      dataUri = String(reader.result);
      const img = $<HTMLImageElement>('ib-img');
      img.onload = () => ($('ib-dims').textContent = `${img.naturalWidth}×${img.naturalHeight}`);
      img.src = dataUri;
      $('ib-name').textContent = file.name;
      $('ib-size').textContent = formatBytes(file.size);
      $('ib-len').textContent = `${dataUri.length.toLocaleString()} chars (+${Math.round((dataUri.length / file.size - 1) * 100)}%)`;
      $('ib-big').hidden = file.size < 10 * 1024;
      $('ib-result').hidden = false;
      renderOut();
    };
    reader.readAsDataURL(file);
  }

  const drop = $('ib-drop');
  const fileEl = $<HTMLInputElement>('ib-file');
  fileEl.addEventListener('change', () => fileEl.files?.[0] && load(fileEl.files[0]));
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.dataset.over = '';
  });
  drop.addEventListener('dragleave', () => delete drop.dataset.over);
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    delete drop.dataset.over;
    const f = e.dataTransfer?.files[0];
    if (f) load(f);
  });
  document.addEventListener('paste', (e) => {
    if (mode() !== 'enc') return;
    const f = e.clipboardData?.files[0];
    if (f) load(f);
  });

  // ---- decode ----
  const sniff = (b64: string) =>
    b64.startsWith('iVBOR') ? 'image/png' : b64.startsWith('/9j/') ? 'image/jpeg' : b64.startsWith('R0lG') ? 'image/gif' : b64.startsWith('UklGR') ? 'image/webp' : b64.startsWith('PHN2Zy') || b64.startsWith('PD94bW') ? 'image/svg+xml' : 'image/png';
  const input = $<HTMLTextAreaElement>('ib-in');
  input.addEventListener('input', () => {
    const s = input.value.trim().replace(/^["'(]+|["')]+$/g, '');
    $('ib-err').hidden = true;
    $('ib-prev').hidden = true;
    if (!s) return;
    let uri: string;
    let mime: string;
    try {
      if (s.startsWith('data:')) {
        uri = s;
        mime = parseDataUri(s).mime;
      } else {
        const b64 = s.replace(/\s/g, '');
        if (!/^[A-Za-z0-9+/_-]+=*$/.test(b64)) throw new Error('Not valid Base64');
        mime = sniff(b64);
        uri = `data:${mime};base64,${b64}`;
      }
    } catch (e) {
      $('ib-err').hidden = false;
      $('ib-err').textContent = (e as Error).message;
      return;
    }
    const img = $<HTMLImageElement>('ib-img2');
    img.onload = () => {
      const b64 = uri.slice(uri.indexOf(',') + 1);
      $('ib-info').textContent = `${mime} · ${img.naturalWidth}×${img.naturalHeight} · ${formatBytes(base64Size(b64))}`;
      const a = $<HTMLAnchorElement>('ib-dl');
      a.href = uri;
      a.download = `image.${mime.split('/')[1].replace('svg+xml', 'svg').replace('jpeg', 'jpg')}`;
      $('ib-prev').hidden = false;
    };
    img.onerror = () => {
      $('ib-err').hidden = false;
      $('ib-err').textContent = L.bad;
    };
    img.src = uri;
  });
</script>
