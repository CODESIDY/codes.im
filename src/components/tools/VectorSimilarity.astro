---
import { useTranslations, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = {
  en: {
    a: 'Vector A',
    b: 'Vector B',
    ph: 'JSON array, embedding API response, or numbers separated by commas / spaces',
    dims: 'Dimensions',
    cosine: 'Cosine similarity',
    distance: 'Cosine distance',
    angle: 'Angle',
    dot: 'Dot product',
    euclid: 'Euclidean (L2)',
    manhattan: 'Manhattan (L1)',
    normA: '‖A‖',
    normB: '‖B‖',
    unit: 'Both vectors are unit length, so dot product = cosine similarity.',
    norm: 'Normalize A',
  },
  zh: {
    a: '向量 A',
    b: '向量 B',
    ph: 'JSON 数组、Embedding 接口返回值，或用逗号 / 空格分隔的数字',
    dims: '维度',
    cosine: '余弦相似度',
    distance: '余弦距离',
    angle: '夹角',
    dot: '点积',
    euclid: '欧氏距离 (L2)',
    manhattan: '曼哈顿距离 (L1)',
    normA: '‖A‖',
    normB: '‖B‖',
    unit: '两个向量都已归一化（长度为 1），此时点积等于余弦相似度。',
    norm: '归一化 A',
  },
}[lang];
const metrics = ['dims', 'cosine', 'distance', 'angle', 'dot', 'euclid', 'manhattan', 'normA', 'normB'] as const;
---

<div id="vs" data-l={JSON.stringify(L)}>
  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <span class="label mb-0">{L.a}</span>
        <span class="flex gap-1.5">
          <button type="button" class="btn px-2 py-1 text-xs" id="vs-norm">{L.norm}</button>
          <button type="button" class="btn px-2 py-1 text-xs" id="vs-sample">{t('common.sample')}</button>
        </span>
      </div>
      <textarea id="vs-a" class="field min-h-36!" spellcheck="false" placeholder={L.ph}></textarea>
    </div>
    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <span class="label mb-0">{L.b}</span>
        <button type="button" class="btn px-2 py-1 text-xs" id="vs-swap">{t('common.swap')}</button>
      </div>
      <textarea id="vs-b" class="field min-h-36!" spellcheck="false" placeholder={L.ph}></textarea>
    </div>
  </div>
  <p id="vs-err" class="mt-3 error-box" hidden></p>

  <div id="vs-out" class="mt-5" hidden>
    <div class="flex flex-wrap items-center gap-4">
      <div>
        <p class="text-xs text-zinc-500">{L.cosine}</p>
        <p id="vs-big" class="font-mono text-3xl font-semibold text-zinc-900 dark:text-zinc-50"></p>
      </div>
      <div class="h-2 min-w-40 flex-1 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
        <div id="vs-bar" class="h-full rounded-full bg-brand-500 transition-all"></div>
      </div>
    </div>
    <dl class="mt-4 grid gap-2 sm:grid-cols-3">
      {
        metrics.map((k) => (
          <div class="rounded-lg bg-zinc-50 px-3 py-2 dark:bg-zinc-800/50">
            <dt class="text-xs text-zinc-500">{L[k]}</dt>
            <dd id={`vs-${k}`} class="font-mono text-sm text-zinc-900 dark:text-zinc-100" />
          </div>
        ))
      }
    </dl>
    <p id="vs-unit" class="mt-3 text-xs text-zinc-500" hidden>{L.unit}</p>
  </div>
</div>

<script>
  import { compare, normalize, parseVector } from '../../lib/vector';

  const a = document.getElementById('vs-a') as HTMLTextAreaElement;
  const b = document.getElementById('vs-b') as HTMLTextAreaElement;
  const err = document.getElementById('vs-err')!;
  const out = document.getElementById('vs-out')!;
  const set = (k: string, v: string) => (document.getElementById(`vs-${k}`)!.textContent = v);
  const f = (n: number, d = 6) => (Math.abs(n) >= 1e6 || (n !== 0 && Math.abs(n) < 1e-4) ? n.toExponential(3) : +n.toFixed(d) + '');

  function run() {
    err.hidden = true;
    if (!a.value.trim() || !b.value.trim()) {
      out.hidden = true;
      return;
    }
    try {
      const r = compare(parseVector(a.value), parseVector(b.value));
      out.hidden = false;
      set('big', r.cosine.toFixed(4));
      (document.getElementById('vs-bar') as HTMLElement).style.width = `${Math.max(0, r.cosine) * 100}%`;
      set('dims', String(r.dims));
      set('cosine', f(r.cosine));
      set('distance', f(r.cosineDistance));
      set('angle', `${r.angle.toFixed(2)}°`);
      set('dot', f(r.dot));
      set('euclid', f(r.euclidean));
      set('manhattan', f(r.manhattan));
      set('normA', f(r.normA));
      set('normB', f(r.normB));
      document.getElementById('vs-unit')!.hidden = !(Math.abs(r.normA - 1) < 1e-3 && Math.abs(r.normB - 1) < 1e-3);
    } catch (e) {
      out.hidden = true;
      err.hidden = false;
      err.textContent = (e as Error).message;
    }
  }

  a.addEventListener('input', run);
  b.addEventListener('input', run);
  document.getElementById('vs-swap')!.addEventListener('click', () => {
    [a.value, b.value] = [b.value, a.value];
    run();
  });
  document.getElementById('vs-norm')!.addEventListener('click', () => {
    try {
      a.value = JSON.stringify(normalize(parseVector(a.value)).map((x) => +x.toFixed(8)));
      run();
    } catch (e) {
      err.hidden = false;
      err.textContent = (e as Error).message;
    }
  });
  document.getElementById('vs-sample')!.addEventListener('click', () => {
    a.value = '[0.12, -0.53, 0.33, 0.78, -0.04, 0.21]';
    b.value = '{"data":[{"embedding":[0.10, -0.49, 0.41, 0.70, 0.02, 0.18]}]}';
    run();
  });
</script>
