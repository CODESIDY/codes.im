---
import { useTranslations, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = {
  en: { encode: 'Encode', decode: 'Decode', component: 'Component', full: 'Full URL', plus: 'Space as +', bad: 'Malformed percent-encoding', parser: 'URL parser', part: 'Part', value: 'Value', params: 'Query parameters', key: 'Key', none: 'Enter a full URL (with https://) to see its parts.' },
  zh: { encode: '编码', decode: '解码', component: '组件', full: '完整 URL', plus: '空格转 +', bad: '百分号编码格式错误', parser: 'URL 解析', part: '部分', value: '值', params: '查询参数', key: '键', none: '输入完整的 URL（带 https://）即可查看各部分。' },
}[lang];
---

<div id="url" data-l={JSON.stringify(L)}>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <label class="chip"><input type="radio" name="url-mode" value="encode" checked class="sr-only" />{L.encode}</label>
    <label class="chip"><input type="radio" name="url-mode" value="decode" class="sr-only" />{L.decode}</label>
    <span class="mx-2 h-5 w-px bg-zinc-200 dark:bg-zinc-700"></span>
    <label class="chip"><input type="radio" name="url-kind" value="component" checked class="sr-only" />{L.component}</label>
    <label class="chip"><input type="radio" name="url-kind" value="full" class="sr-only" />{L.full}</label>
    <label class="chip"><input type="checkbox" id="url-plus" class="sr-only" />{L.plus}</label>
    <span class="ml-auto flex gap-2">
      <button type="button" class="btn" data-act="swap">⇅ {t('common.swap')}</button>
      <button type="button" class="btn" data-act="clear">{t('common.clear')}</button>
    </span>
  </div>
  <div class="grid gap-4 lg:grid-cols-2">
    <div>
      <label class="label mb-1.5 flex h-[22px] items-center" for="url-in">{t('common.input')}</label>
      <textarea id="url-in" class="field min-h-36" spellcheck="false" placeholder="https://codes.im/search?q=你好 world&lang=zh"
      ></textarea>
    </div>
    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <label class="label mb-0" for="url-out">{t('common.output')}</label>
        <button type="button" class="btn px-2 py-0.5 text-xs" data-copy="#url-out">{t('common.copy')}</button>
      </div>
      <textarea id="url-out" class="field min-h-36" spellcheck="false" readonly></textarea>
    </div>
  </div>
  <p id="url-err" class="mt-3 error-box" hidden></p>

  <h3 class="mt-6 mb-2 text-sm font-semibold text-zinc-900 dark:text-zinc-100">{L.parser}</h3>
  <div id="url-parts" class="text-sm text-zinc-500">{L.none}</div>
</div>

<script>
  const root = document.getElementById('url')!;
  const L = JSON.parse(root.dataset.l!);
  const input = document.getElementById('url-in') as HTMLTextAreaElement;
  const output = document.getElementById('url-out') as HTMLTextAreaElement;
  const plus = document.getElementById('url-plus') as HTMLInputElement;
  const err = document.getElementById('url-err')!;
  const partsEl = document.getElementById('url-parts')!;

  const val = (n: string) => (root.querySelector(`input[name="${n}"]:checked`) as HTMLInputElement).value;

  function table(rows: [string, string][], h1: string, h2: string) {
    const tbl = document.createElement('table');
    tbl.className = 'w-full overflow-hidden rounded-lg border border-zinc-200 text-left text-sm dark:border-zinc-800';
    const head = tbl.createTHead().insertRow();
    for (const h of [h1, h2]) {
      const th = document.createElement('th');
      th.className = 'bg-zinc-50 px-3 py-2 text-xs font-medium text-zinc-500 dark:bg-zinc-900';
      th.textContent = h;
      head.append(th);
    }
    const body = tbl.createTBody();
    for (const [k, v] of rows) {
      const tr = body.insertRow();
      tr.className = 'border-t border-zinc-200 dark:border-zinc-800';
      const a = tr.insertCell();
      a.className = 'px-3 py-1.5 font-mono text-xs text-zinc-500 whitespace-nowrap align-top';
      a.textContent = k;
      const b = tr.insertCell();
      b.className = 'px-3 py-1.5 font-mono text-xs break-all text-zinc-800 dark:text-zinc-200';
      b.textContent = v;
    }
    return tbl;
  }

  function parse(text: string) {
    let u: URL;
    try {
      u = new URL(text.trim());
    } catch {
      partsEl.replaceChildren(L.none);
      return;
    }
    const rows: [string, string][] = [
      ['protocol', u.protocol],
      ['host', u.host],
      ['pathname', decodeURIComponent(u.pathname)],
      ['search', u.search],
      ['hash', u.hash],
      ['origin', u.origin],
    ];
    if (u.username) rows.splice(1, 0, ['username', u.username]);
    if (u.port) rows.splice(2, 0, ['port', u.port]);
    const nodes: Node[] = [table(rows.filter(([, v]) => v), L.part, L.value)];
    const params = [...u.searchParams.entries()];
    if (params.length) {
      const h = document.createElement('p');
      h.className = 'mt-4 mb-2 text-xs font-medium text-zinc-500 uppercase';
      h.textContent = `${L.params} (${params.length})`;
      nodes.push(h, table(params, L.key, L.value));
    }
    partsEl.replaceChildren(...nodes);
  }

  function run() {
    err.hidden = true;
    const v = input.value;
    const full = val('url-kind') === 'full';
    try {
      if (val('url-mode') === 'encode') {
        let out = full ? encodeURI(v) : encodeURIComponent(v);
        if (plus.checked) out = out.replace(/%20/g, '+');
        output.value = out;
      } else {
        const src = plus.checked ? v.replace(/\+/g, ' ') : v;
        output.value = full ? decodeURI(src) : decodeURIComponent(src);
      }
    } catch {
      output.value = '';
      err.hidden = false;
      err.textContent = L.bad;
    }
    parse(val('url-mode') === 'encode' ? v : output.value || v);
  }

  root.addEventListener('input', run);
  root.addEventListener('change', run);
  root.addEventListener('click', (e) => {
    const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
    if (act === 'swap') {
      input.value = output.value;
      const next = val('url-mode') === 'encode' ? 'decode' : 'encode';
      (root.querySelector(`input[name="url-mode"][value="${next}"]`) as HTMLInputElement).checked = true;
      run();
    } else if (act === 'clear') {
      input.value = '';
      run();
    }
  });
</script>
