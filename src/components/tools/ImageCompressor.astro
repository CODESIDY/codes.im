---
import { type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = {
  en: {
    drop: 'Drop images here, paste, or click to choose',
    hint: 'JPEG, PNG, WebP, GIF (first frame), BMP · processed locally, never uploaded',
    format: 'Output format',
    keep: 'Same as input',
    quality: 'Quality',
    maxW: 'Max width',
    maxH: 'Max height',
    none: 'no limit',
    download: 'Download',
    all: 'Download all',
    clear: 'Clear',
    larger: 'Output is larger than the original — try WebP or a lower quality.',
    pngq: 'PNG is lossless, so quality has no effect.',
  },
  zh: {
    drop: '把图片拖到这里、直接粘贴，或点击选择',
    hint: '支持 JPEG、PNG、WebP、GIF（取第一帧）、BMP · 本地处理，不会上传',
    format: '输出格式',
    keep: '与原图相同',
    quality: '质量',
    maxW: '最大宽度',
    maxH: '最大高度',
    none: '不限制',
    download: '下载',
    all: '全部下载',
    clear: '清空',
    larger: '输出比原图还大 —— 试试 WebP 或调低质量。',
    pngq: 'PNG 是无损格式，质量参数不生效。',
  },
}[lang];
---

<div id="ic" data-l={JSON.stringify(L)}>
  <label
    id="ic-drop"
    class="flex cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-zinc-300 px-4 py-10 text-center transition hover:border-brand-500 data-[over]:border-brand-500 data-[over]:bg-brand-50 dark:border-zinc-700 dark:data-[over]:bg-brand-500/10"
  >
    <svg viewBox="0 0 24 24" class="h-8 w-8 text-zinc-400" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
      ><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg
    >
    <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{L.drop}</span>
    <span class="text-xs text-zinc-500">{L.hint}</span>
    <input id="ic-file" type="file" accept="image/*" multiple class="sr-only" />
  </label>

  <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <label class="block"
      ><span class="label">{L.format}</span>
      <select id="ic-fmt" class="field">
        <option value="image/webp">WebP</option>
        <option value="image/jpeg">JPEG</option>
        <option value="image/png">PNG</option>
        <option value="keep">{L.keep}</option>
      </select></label
    >
    <label class="block"
      ><span class="label">{L.quality} <span id="ic-q-v" class="font-mono normal-case">80</span></span>
      <input id="ic-q" type="range" min="10" max="100" value="80" class="mt-2 w-full accent-brand-600" /></label
    >
    <label class="block"><span class="label">{L.maxW}</span><input id="ic-w" type="number" min="0" step="10" placeholder={L.none} class="field font-mono" /></label>
    <label class="block"><span class="label">{L.maxH}</span><input id="ic-h" type="number" min="0" step="10" placeholder={L.none} class="field font-mono" /></label>
  </div>
  <p id="ic-pngq" class="mt-2 text-xs text-zinc-500" hidden>{L.pngq}</p>

  <div id="ic-bar" class="mt-5 flex flex-wrap items-center gap-2" hidden>
    <span id="ic-total" class="mr-auto font-mono text-sm text-zinc-600 dark:text-zinc-400"></span>
    <button type="button" class="btn btn-primary" id="ic-all">{L.all}</button>
    <button type="button" class="btn" id="ic-clear">{L.clear}</button>
  </div>
  <ul id="ic-list" class="mt-3 space-y-2"></ul>
</div>

<script>
  import { fitSize, formatBytes, savedPercent } from '../../lib/image';

  interface Item {
    file: File;
    out?: Blob;
    url?: string;
    li: HTMLLIElement;
  }
  const root = document.getElementById('ic')!;
  const L = JSON.parse(root.dataset.l!);
  const drop = document.getElementById('ic-drop')!;
  const fileEl = document.getElementById('ic-file') as HTMLInputElement;
  const fmt = document.getElementById('ic-fmt') as HTMLSelectElement;
  const q = document.getElementById('ic-q') as HTMLInputElement;
  const list = document.getElementById('ic-list')!;
  const bar = document.getElementById('ic-bar')!;
  const items: Item[] = [];
  const ext: Record<string, string> = { 'image/webp': 'webp', 'image/jpeg': 'jpg', 'image/png': 'png' };

  function outType(f: File) {
    const v = fmt.value;
    if (v !== 'keep') return v;
    return ext[f.type] ? f.type : 'image/png';
  }

  async function encode(item: Item) {
    const bmp = await createImageBitmap(item.file);
    const size = fitSize(bmp.width, bmp.height, Number((document.getElementById('ic-w') as HTMLInputElement).value), Number((document.getElementById('ic-h') as HTMLInputElement).value));
    const canvas = document.createElement('canvas');
    canvas.width = size.width;
    canvas.height = size.height;
    const ctx = canvas.getContext('2d')!;
    const type = outType(item.file);
    if (type === 'image/jpeg') {
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, size.width, size.height);
    }
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(bmp, 0, 0, size.width, size.height);
    bmp.close();
    const blob = await new Promise<Blob | null>((r) => canvas.toBlob(r, type, Number(q.value) / 100));
    if (!blob) throw new Error('Encoding failed');
    return { blob, ...size, type, srcW: canvas.width };
  }

  function name(item: Item) {
    const base = item.file.name.replace(/\.[^.]+$/, '');
    return `${base}.${ext[outType(item.file)]}`;
  }

  async function process(item: Item) {
    const li = item.li;
    li.querySelector('[data-out]')!.textContent = '…';
    try {
      const r = await encode(item);
      item.out = r.blob;
      if (item.url) URL.revokeObjectURL(item.url);
      item.url = URL.createObjectURL(r.blob);
      (li.querySelector('img') as HTMLImageElement).src = item.url;
      const pct = savedPercent(item.file.size, r.blob.size);
      li.querySelector('[data-out]')!.textContent = `→ ${formatBytes(r.blob.size)} · ${r.width}×${r.height}`;
      const badge = li.querySelector<HTMLElement>('[data-pct]')!;
      badge.textContent = `${pct > 0 ? '−' : '+'}${Math.abs(pct)}%`;
      badge.className = 'rounded px-1.5 py-0.5 font-mono text-xs font-semibold ' + (pct > 0 ? 'bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-400' : 'bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400');
      badge.title = pct > 0 ? '' : L.larger;
      const a = li.querySelector('a')!;
      a.href = item.url;
      a.download = name(item);
    } catch (e) {
      li.querySelector('[data-out]')!.textContent = (e as Error).message;
    }
    total();
  }

  function total() {
    const done = items.filter((i) => i.out);
    const before = done.reduce((s, i) => s + i.file.size, 0);
    const after = done.reduce((s, i) => s + i.out!.size, 0);
    document.getElementById('ic-total')!.textContent = done.length ? `${done.length} · ${formatBytes(before)} → ${formatBytes(after)} (−${savedPercent(before, after)}%)` : '';
    bar.hidden = !items.length;
  }

  function add(files: Iterable<File>) {
    for (const file of files) {
      if (!file.type.startsWith('image/')) continue;
      const li = document.createElement('li');
      li.className = 'card flex items-center gap-3 p-2.5';
      li.innerHTML =
        '<img class="h-14 w-14 shrink-0 rounded-md bg-zinc-100 object-cover dark:bg-zinc-800" alt="" />' +
        '<div class="min-w-0 flex-1"><p data-name class="truncate text-sm font-medium text-zinc-900 dark:text-zinc-100"></p>' +
        '<p class="font-mono text-xs text-zinc-500"><span data-in></span> <span data-out></span></p></div>' +
        '<span data-pct></span><a class="btn px-2 py-1 text-xs"></a>';
      li.querySelector('[data-name]')!.textContent = file.name;
      li.querySelector('[data-in]')!.textContent = formatBytes(file.size);
      li.querySelector('a')!.textContent = L.download;
      list.append(li);
      const item: Item = { file, li };
      items.push(item);
      process(item);
    }
    total();
  }

  fileEl.addEventListener('change', () => {
    add(fileEl.files ?? []);
    fileEl.value = '';
  });
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.dataset.over = '';
  });
  drop.addEventListener('dragleave', () => delete drop.dataset.over);
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    delete drop.dataset.over;
    add(e.dataTransfer?.files ?? []);
  });
  document.addEventListener('paste', (e) => {
    const files = [...(e.clipboardData?.files ?? [])];
    if (files.length) add(files);
  });

  let timer = 0;
  const reprocess = () => {
    document.getElementById('ic-q-v')!.textContent = q.value;
    document.getElementById('ic-pngq')!.hidden = fmt.value !== 'image/png';
    clearTimeout(timer);
    timer = window.setTimeout(() => items.forEach(process), 200);
  };
  ['ic-fmt', 'ic-q', 'ic-w', 'ic-h'].forEach((id) => document.getElementById(id)!.addEventListener('input', reprocess));

  document.getElementById('ic-all')!.addEventListener('click', async () => {
    for (const i of items) {
      if (!i.url) continue;
      i.li.querySelector('a')!.click();
      await new Promise((r) => setTimeout(r, 250));
    }
  });
  document.getElementById('ic-clear')!.addEventListener('click', () => {
    items.forEach((i) => i.url && URL.revokeObjectURL(i.url));
    items.length = 0;
    list.replaceChildren();
    total();
  });
</script>
