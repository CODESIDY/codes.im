---
import { useTranslations, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = {
  en: { password: 'Password', token: 'Token / API key', length: 'Length', bytes: 'Bytes', count: 'How many', lower: 'a–z', upper: 'A–Z', digits: '0–9', symbols: '!@#', ambiguous: 'Exclude look-alikes', generate: 'Regenerate', copyAll: 'Copy all', bits: 'bits of entropy', strength: { weak: 'Weak', fair: 'Fair', strong: 'Strong', 'very-strong': 'Very strong' }, none: 'Select at least one character set.' },
  zh: { password: '密码', token: '密钥 / API Key', length: '长度', bytes: '字节数', count: '数量', lower: 'a–z', upper: 'A–Z', digits: '0–9', symbols: '!@#', ambiguous: '排除易混淆字符', generate: '重新生成', copyAll: '全部复制', bits: '位熵', strength: { weak: '弱', fair: '一般', strong: '强', 'very-strong': '非常强' }, none: '请至少选择一种字符类型。' },
}[lang];
---

<div id="pw" data-l={JSON.stringify(L)}>
  <div class="mb-4 flex flex-wrap items-center gap-1.5">
    <label class="chip"><input type="radio" name="pw-mode" value="password" checked class="sr-only" />{L.password}</label>
    <label class="chip"><input type="radio" name="pw-mode" value="token" class="sr-only" />{L.token}</label>
  </div>

  <div data-mode="password" class="flex flex-wrap items-end gap-4">
    <div class="w-full max-w-sm">
      <label class="label" for="pw-len">{L.length}: <span id="pw-len-v" class="font-mono text-zinc-900 dark:text-zinc-100"></span></label>
      <input id="pw-len" type="range" min="6" max="128" value="20" class="w-full accent-brand-600" />
    </div>
    <div class="flex flex-wrap gap-1.5">
      {(['lower', 'upper', 'digits', 'symbols'] as const).map((k) => <label class="chip font-mono"><input type="checkbox" data-set={k} checked class="sr-only" />{L[k]}</label>)}
      <label class="chip"><input type="checkbox" id="pw-amb" class="sr-only" />{L.ambiguous}</label>
    </div>
  </div>

  <div data-mode="token" class="flex flex-wrap items-end gap-4" hidden>
    <div>
      <label class="label" for="pw-bytes">{L.bytes}</label>
      <select id="pw-bytes" class="field h-8 w-auto py-0">
        <option value="16">16 (128 bit)</option>
        <option value="24">24 (192 bit)</option>
        <option value="32" selected>32 (256 bit)</option>
        <option value="64">64 (512 bit)</option>
      </select>
    </div>
    <div class="flex gap-1.5">
      <label class="chip"><input type="radio" name="pw-fmt" value="hex" checked class="sr-only" />hex</label>
      <label class="chip"><input type="radio" name="pw-fmt" value="base64url" class="sr-only" />base64url</label>
      <label class="chip"><input type="radio" name="pw-fmt" value="base62" class="sr-only" />base62</label>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-end gap-4">
    <div>
      <label class="label" for="pw-count">{L.count}</label>
      <input id="pw-count" type="number" min="1" max="100" value="5" class="field h-8 w-20 py-0" />
    </div>
    <span class="ml-auto flex gap-2">
      <button type="button" class="btn btn-primary" id="pw-gen">↻ {L.generate}</button>
      <button type="button" class="btn" data-copy="#pw-all">{L.copyAll}</button>
    </span>
  </div>

  <div class="mt-4">
    <div class="h-1.5 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800"><div id="pw-bar" class="h-full rounded-full transition-all"></div></div>
    <p id="pw-meta" class="mt-1.5 font-mono text-xs text-zinc-500"></p>
  </div>
  <p id="pw-err" class="mt-3 error-box" hidden>{L.none}</p>
  <ul id="pw-list" class="mt-3 divide-y divide-zinc-200 rounded-lg border border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800"></ul>
  <textarea id="pw-all" class="sr-only" aria-hidden="true" tabindex="-1"></textarea>
  <template id="pw-row">
    <li class="flex items-center gap-3 px-3 py-2">
      <code class="min-w-0 flex-1 font-mono text-[15px] break-all text-zinc-900 dark:text-zinc-100"></code>
      <button type="button" class="btn shrink-0 px-2 py-0.5 text-xs">{t('common.copy')}</button>
    </li>
  </template>
</div>

<script>
  import { entropyBits, generatePassword, generateToken, poolSize, strengthLabel, type TokenFormat } from '../../lib/password';

  const root = document.getElementById('pw')!;
  const L = JSON.parse(root.dataset.l!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(`pw-${id}`) as T;
  const radio = (n: string) => (root.querySelector(`input[name="${n}"]:checked`) as HTMLInputElement).value;
  const COLORS = { weak: '#ef4444', fair: '#f59e0b', strong: '#10b981', 'very-strong': '#059669' };

  function run() {
    const mode = radio('pw-mode');
    root.querySelectorAll<HTMLElement>('[data-mode]').forEach((el) => (el.hidden = el.dataset.mode !== mode));
    $('len-v').textContent = $<HTMLInputElement>('len').value;
    const count = Math.min(100, Math.max(1, Number($<HTMLInputElement>('count').value) || 1));
    $('err').hidden = true;
    let items: string[] = [];
    let bits = 0;
    try {
      if (mode === 'password') {
        const o = {
          length: Number($<HTMLInputElement>('len').value),
          excludeAmbiguous: $<HTMLInputElement>('amb').checked,
          lower: false,
          upper: false,
          digits: false,
          symbols: false,
        };
        root.querySelectorAll<HTMLInputElement>('[data-set]').forEach((c) => (o[c.dataset.set as 'lower'] = c.checked));
        items = Array.from({ length: count }, () => generatePassword(o));
        bits = entropyBits(o.length, poolSize(o));
      } else {
        const bytes = Number($<HTMLSelectElement>('bytes').value);
        items = Array.from({ length: count }, () => generateToken(bytes, radio('pw-fmt') as TokenFormat));
        bits = bytes * 8;
      }
    } catch {
      $('err').hidden = false;
    }
    const label = strengthLabel(bits) as keyof typeof COLORS;
    const bar = $('bar');
    bar.style.width = `${Math.min(100, (bits / 128) * 100)}%`;
    bar.style.background = COLORS[label];
    $('meta').textContent = items.length ? `${Math.round(bits)} ${L.bits} · ${L.strength[label]}` : '';
    const tpl = $<HTMLTemplateElement>('row');
    $('list').replaceChildren(
      ...items.map((v) => {
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        li.querySelector('code')!.textContent = v;
        li.querySelector('button')!.dataset.copyText = v;
        return li;
      }),
    );
    $<HTMLTextAreaElement>('all').value = items.join('\n');
  }

  root.addEventListener('input', run);
  root.addEventListener('change', run);
  $('gen').addEventListener('click', run);
  run();
</script>
