---
import { useTranslations, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = {
  en: { input: 'Any CSS color', invalid: 'Unrecognised color. Try #10b981, rgb(16 185 129), hsl(160 84% 39%) or oklch(70% 0.15 165).', contrast: 'Contrast', onWhite: 'on white', onBlack: 'on black', sample: 'Sample text' },
  zh: { input: '任意 CSS 颜色', invalid: '无法识别的颜色。可以试试 #10b981、rgb(16 185 129)、hsl(160 84% 39%) 或 oklch(70% 0.15 165)。', contrast: '对比度', onWhite: '白底', onBlack: '黑底', sample: '示例文字' },
}[lang];
---

<div id="color" data-l={JSON.stringify(L)}>
  <div class="grid gap-6 lg:grid-cols-[1fr_280px]">
    <div>
      <label class="label" for="color-in">{L.input}</label>
      <div class="flex gap-2">
        <input id="color-picker" type="color" value="#10b981" class="h-10 w-12 shrink-0 cursor-pointer rounded-lg border border-zinc-300 bg-transparent p-1 dark:border-zinc-700" aria-label="Color picker" />
        <input id="color-in" class="field font-mono" value="#10b981" spellcheck="false" autocomplete="off" />
      </div>
      <p id="color-err" class="mt-2 error-box" hidden>{L.invalid}</p>

      <dl class="mt-4 divide-y divide-zinc-200 rounded-lg border border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
        {
          ['hex', 'rgb', 'hsl', 'oklch'].map((k) => (
            <div class="flex items-center gap-3 px-3 py-2.5">
              <dt class="w-14 shrink-0 font-mono text-xs font-semibold text-zinc-500 uppercase">{k}</dt>
              <dd id={`c-${k}`} class="min-w-0 flex-1 font-mono text-[13px] text-zinc-900 dark:text-zinc-100" />
              <button type="button" class="btn px-2 py-0.5 text-xs" data-copy={`#c-${k}`}>
                {t('common.copy')}
              </button>
            </div>
          ))
        }
      </dl>
    </div>

    <div>
      <div id="color-swatch" class="h-32 rounded-xl border border-zinc-200 dark:border-zinc-800"></div>
      <p class="mt-4 mb-2 text-xs font-medium tracking-wide text-zinc-500 uppercase">{L.contrast}</p>
      <div class="grid grid-cols-2 gap-2">
        <div class="rounded-lg border border-zinc-200 bg-white p-3 dark:border-zinc-800">
          <p id="color-on-white" class="text-sm font-semibold">{L.sample}</p>
          <p class="mt-1 font-mono text-xs text-zinc-500"><span id="cr-white"></span> {L.onWhite}</p>
          <p id="cr-white-badge" class="mt-1 text-[11px] font-semibold"></p>
        </div>
        <div class="rounded-lg border border-zinc-800 bg-black p-3">
          <p id="color-on-black" class="text-sm font-semibold">{L.sample}</p>
          <p class="mt-1 font-mono text-xs text-zinc-400"><span id="cr-black"></span> {L.onBlack}</p>
          <p id="cr-black-badge" class="mt-1 text-[11px] font-semibold"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { contrastRatio, formats, parseColor } from '../../lib/color';

  const input = document.getElementById('color-in') as HTMLInputElement;
  const picker = document.getElementById('color-picker') as HTMLInputElement;
  const err = document.getElementById('color-err')!;
  const swatch = document.getElementById('color-swatch')!;
  const WHITE = { r: 255, g: 255, b: 255, a: 1 };
  const BLACK = { r: 0, g: 0, b: 0, a: 1 };

  function badge(el: HTMLElement, ratio: number) {
    const level = ratio >= 7 ? 'AAA' : ratio >= 4.5 ? 'AA' : ratio >= 3 ? 'AA Large' : 'Fail';
    el.textContent = level === 'Fail' ? '✕ Fail' : `✓ ${level}`;
    el.style.color = level === 'Fail' ? '#ef4444' : '#10b981';
  }

  function run(fromPicker = false) {
    const c = parseColor(fromPicker ? picker.value : input.value);
    err.hidden = !!c || !input.value.trim();
    if (!c) return;
    const f = formats(c);
    if (fromPicker) input.value = f.hex;
    else picker.value = f.hex.slice(0, 7);
    for (const k of ['hex', 'rgb', 'hsl', 'oklch'] as const) document.getElementById(`c-${k}`)!.textContent = f[k];
    swatch.style.background = f.rgb;
    document.getElementById('color-on-white')!.style.color = f.rgb;
    document.getElementById('color-on-black')!.style.color = f.rgb;
    const opaque = { ...c, a: 1 };
    const w = contrastRatio(opaque, WHITE);
    const b = contrastRatio(opaque, BLACK);
    document.getElementById('cr-white')!.textContent = w.toFixed(2) + ':1';
    document.getElementById('cr-black')!.textContent = b.toFixed(2) + ':1';
    badge(document.getElementById('cr-white-badge')!, w);
    badge(document.getElementById('cr-black-badge')!, b);
  }

  input.addEventListener('input', () => run());
  picker.addEventListener('input', () => run(true));
  run();
</script>
