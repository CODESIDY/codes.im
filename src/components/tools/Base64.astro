---
import { useTranslations, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = {
  en: { encode: 'Encode', decode: 'Decode', urlsafe: 'URL-safe', file: 'File → Base64', dataUri: 'as data URI', bad: 'Not valid Base64 (or not UTF-8 text)' },
  zh: { encode: '编码', decode: '解码', urlsafe: 'URL Safe', file: '文件 → Base64', dataUri: '输出 Data URI', bad: '不是合法的 Base64（或解码结果不是 UTF-8 文本）' },
}[lang];
---

<div id="b64" data-l={JSON.stringify(L)}>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <label class="chip"><input type="radio" name="b64-mode" value="encode" checked class="sr-only" />{L.encode}</label>
    <label class="chip"><input type="radio" name="b64-mode" value="decode" class="sr-only" />{L.decode}</label>
    <label class="chip ml-2"><input type="checkbox" id="b64-url" class="sr-only" />{L.urlsafe}</label>
    <span class="ml-auto flex flex-wrap items-center gap-2">
      <label class="btn">
        {L.file}
        <input type="file" id="b64-file" class="sr-only" />
      </label>
      <label class="chip"><input type="checkbox" id="b64-datauri" checked class="sr-only" />{L.dataUri}</label>
      <button type="button" class="btn" data-act="swap">⇅ {t('common.swap')}</button>
      <button type="button" class="btn" data-act="clear">{t('common.clear')}</button>
    </span>
  </div>
  <div class="grid gap-4 lg:grid-cols-2">
    <div>
      <label class="label mb-1.5 flex h-[22px] items-center" for="b64-in">{t('common.input')}</label>
      <textarea id="b64-in" class="field" spellcheck="false" placeholder="Hello, 世界 👋"></textarea>
    </div>
    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <label class="label mb-0" for="b64-out">{t('common.output')}</label>
        <button type="button" class="btn px-2 py-0.5 text-xs" data-copy="#b64-out">{t('common.copy')}</button>
      </div>
      <textarea id="b64-out" class="field" spellcheck="false" readonly></textarea>
    </div>
  </div>
  <p id="b64-err" class="mt-3 error-box" hidden></p>
  <p id="b64-info" class="mt-2 font-mono text-xs text-zinc-500"></p>
</div>

<script>
  import { bytesToBase64, decodeBase64, encodeBase64 } from '../../lib/encoding';

  const root = document.getElementById('b64')!;
  const L = JSON.parse(root.dataset.l!);
  const input = document.getElementById('b64-in') as HTMLTextAreaElement;
  const output = document.getElementById('b64-out') as HTMLTextAreaElement;
  const urlSafe = document.getElementById('b64-url') as HTMLInputElement;
  const file = document.getElementById('b64-file') as HTMLInputElement;
  const dataUri = document.getElementById('b64-datauri') as HTMLInputElement;
  const err = document.getElementById('b64-err')!;
  const info = document.getElementById('b64-info')!;

  const mode = () => (root.querySelector('input[name="b64-mode"]:checked') as HTMLInputElement).value;
  const setMode = (m: string) => ((root.querySelector(`input[name="b64-mode"][value="${m}"]`) as HTMLInputElement).checked = true);

  function run() {
    err.hidden = true;
    const v = input.value;
    if (!v) {
      output.value = '';
      info.textContent = '';
      return;
    }
    try {
      output.value = mode() === 'encode' ? encodeBase64(v, urlSafe.checked) : decodeBase64(v);
      info.textContent = `${v.length.toLocaleString()} → ${output.value.length.toLocaleString()} chars`;
    } catch {
      output.value = '';
      info.textContent = '';
      err.hidden = false;
      err.textContent = L.bad;
    }
  }

  root.addEventListener('input', (e) => {
    if (e.target !== file) run();
  });
  root.addEventListener('change', (e) => {
    if (e.target !== file && e.target !== dataUri) run();
  });
  root.addEventListener('click', (e) => {
    const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
    if (act === 'swap') {
      input.value = output.value;
      setMode(mode() === 'encode' ? 'decode' : 'encode');
      run();
    } else if (act === 'clear') {
      input.value = '';
      run();
    }
  });

  file.addEventListener('change', async () => {
    const f = file.files?.[0];
    if (!f) return;
    const b64 = bytesToBase64(new Uint8Array(await f.arrayBuffer()), urlSafe.checked);
    output.value = dataUri.checked ? `data:${f.type || 'application/octet-stream'};base64,${b64}` : b64;
    input.value = '';
    err.hidden = true;
    info.textContent = `${f.name} · ${f.size.toLocaleString()} bytes → ${output.value.length.toLocaleString()} chars`;
    file.value = '';
  });
</script>
