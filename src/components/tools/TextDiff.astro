---
import { useTranslations, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = {
  en: { original: 'Original', changed: 'Changed', lines: 'Lines', words: 'Words', chars: 'Characters', ws: 'Ignore whitespace', case: 'Ignore case', result: 'Differences', added: 'added', removed: 'removed', same: 'The two texts are identical.' },
  zh: { original: '原文', changed: '修改后', lines: '按行', words: '按词', chars: '按字符', ws: '忽略空白', case: '忽略大小写', result: '差异', added: '新增', removed: '删除', same: '两段文本完全相同。' },
}[lang];
const a = lang === 'zh'
  ? '你是一个乐于助人的助手。\n请用简洁的语言回答用户的问题。\n如果不知道答案，就说不知道。'
  : 'You are a helpful assistant.\nAnswer the user’s question concisely.\nIf you do not know the answer, say so.';
const b = lang === 'zh'
  ? '你是一个专业、乐于助人的编程助手。\n请用简洁、准确的语言回答用户的问题，并给出代码示例。\n如果不知道答案，就说不知道。'
  : 'You are a helpful coding assistant.\nAnswer the user’s question concisely and include a code example.\nIf you do not know the answer, say so.';
---

<div id="diff" data-l={JSON.stringify(L)}>
  <div class="mb-3 flex flex-wrap items-center gap-1.5">
    <label class="chip"><input type="radio" name="diff-mode" value="lines" class="sr-only" />{L.lines}</label>
    <label class="chip"><input type="radio" name="diff-mode" value="words" checked class="sr-only" />{L.words}</label>
    <label class="chip"><input type="radio" name="diff-mode" value="chars" class="sr-only" />{L.chars}</label>
    <span class="mx-2 h-5 w-px bg-zinc-200 dark:bg-zinc-700"></span>
    <label class="chip"><input type="checkbox" id="diff-ws" class="sr-only" />{L.ws}</label>
    <label class="chip"><input type="checkbox" id="diff-case" class="sr-only" />{L.case}</label>
    <button type="button" class="btn ml-auto px-2 py-1 text-xs" id="diff-swap">⇄ {t('common.swap')}</button>
  </div>
  <div class="grid gap-4 lg:grid-cols-2">
    <div>
      <label class="label" for="diff-a">{L.original}</label>
      <textarea id="diff-a" class="field min-h-48" spellcheck="false">{a}</textarea>
    </div>
    <div>
      <label class="label" for="diff-b">{L.changed}</label>
      <textarea id="diff-b" class="field min-h-48" spellcheck="false">{b}</textarea>
    </div>
  </div>
  <div class="mt-4 mb-1.5 flex items-center justify-between">
    <span class="label mb-0">{L.result}</span>
    <span id="diff-stats" class="font-mono text-xs"></span>
  </div>
  <pre id="diff-out" class="code min-h-24 overflow-auto rounded-lg border border-zinc-200 p-3 whitespace-pre-wrap dark:border-zinc-800"></pre>
</div>

<style is:global>
  #diff-out ins {
    text-decoration: none;
    background: oklch(0.9 0.1 150 / 0.8);
    color: oklch(0.35 0.1 150);
    border-radius: 2px;
  }
  #diff-out del {
    background: oklch(0.9 0.08 25 / 0.8);
    color: oklch(0.42 0.15 25);
    border-radius: 2px;
  }
  .dark #diff-out ins {
    background: oklch(0.38 0.08 150 / 0.7);
    color: oklch(0.9 0.08 150);
  }
  .dark #diff-out del {
    background: oklch(0.38 0.1 25 / 0.7);
    color: oklch(0.9 0.06 25);
  }
  #diff-out .line {
    display: block;
    padding: 0 0.25rem;
  }
</style>

<script>
  import { diffChars, diffLines, diffWords, type ChangeObject } from 'diff';

  const root = document.getElementById('diff')!;
  const L = JSON.parse(root.dataset.l!);
  const a = document.getElementById('diff-a') as HTMLTextAreaElement;
  const b = document.getElementById('diff-b') as HTMLTextAreaElement;
  const out = document.getElementById('diff-out')!;
  const stats = document.getElementById('diff-stats')!;
  const ws = document.getElementById('diff-ws') as HTMLInputElement;
  const ic = document.getElementById('diff-case') as HTMLInputElement;
  const segmenter = new Intl.Segmenter(document.documentElement.lang, { granularity: 'word' });

  /** diffLines has no ignoreCase option: diff lowercased copies, then map the result back to the original lines. */
  function linesDiff(x: string, y: string): ChangeObject<string>[] {
    if (!ic.checked) return diffLines(x, y, { ignoreWhitespace: ws.checked });
    const xs = x.split(/(?<=\n)/);
    const ys = y.split(/(?<=\n)/);
    let i = 0;
    let j = 0;
    return diffLines(x.toLowerCase(), y.toLowerCase(), { ignoreWhitespace: ws.checked }).map((p) => {
      const n = p.count ?? 0;
      let value: string;
      if (p.removed) value = xs.slice(i, (i += n)).join('');
      else if (p.added) value = ys.slice(j, (j += n)).join('');
      else {
        value = ys.slice(j, j + n).join('');
        i += n;
        j += n;
      }
      return { ...p, value };
    });
  }

  function run() {
    const mode = (root.querySelector('input[name="diff-mode"]:checked') as HTMLInputElement).value;
    let parts: ChangeObject<string>[];
    if (mode === 'lines') parts = linesDiff(a.value, b.value);
    else if (mode === 'words') parts = diffWords(a.value, b.value, { ignoreCase: ic.checked, intlSegmenter: segmenter });
    else parts = diffChars(a.value, b.value, { ignoreCase: ic.checked });

    let add = 0;
    let del = 0;
    const frag = document.createDocumentFragment();
    for (const p of parts) {
      const el = document.createElement(p.added ? 'ins' : p.removed ? 'del' : 'span');
      if (mode === 'lines' && (p.added || p.removed)) el.className = 'line';
      el.textContent = mode === 'lines' && (p.added || p.removed) ? p.value.replace(/\n$/, '') : p.value;
      if (p.added) add += p.count ?? 1;
      if (p.removed) del += p.count ?? 1;
      frag.append(el);
    }
    out.replaceChildren(frag);
    if (!add && !del) {
      stats.className = 'font-mono text-xs text-brand-600';
      stats.textContent = '✓ ' + L.same;
    } else {
      stats.className = 'font-mono text-xs';
      stats.innerHTML = `<span class="text-green-600">+${add} ${L.added}</span> · <span class="text-red-600">−${del} ${L.removed}</span>`;
    }
  }

  root.addEventListener('input', run);
  root.addEventListener('change', run);
  document.getElementById('diff-swap')!.addEventListener('click', () => {
    [a.value, b.value] = [b.value, a.value];
    run();
  });
  run();
</script>
